{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRD_Schema",
  "description": "The technical blueprint for Worker Agents to follow.",
  "type": "object",
  "properties": {
    "product_name": { "type": "string" },
    "core_feature_set": { "type": "array", "items": { "type": "string" } },
    "target_platforms": { "type": "array", "items": { "enum": ["Etsy", "Gumroad", "Amazon KDP", "Direct Web"] } },
    "worker_assignments": {
      "type": "object",
      "patternProperties": {
        "^Worker_.*$": {
          "type": "object",
          "properties": {
            "task_description": { "type": "string" },
            "required_output_format": { "type": "string" },
            "context_payload": { "type": "object" }
          },
          "required": ["task_description", "required_output_format"]
        }
      }
    }
  },
  "required": ["product_name", "core_feature_set", "worker_assignments"]
}
